# ============================================================
# UrbanMove - variables de entorno para desarrollo LOCAL
# ============================================================
# Copia este fichero a .env y cambia los valores.
# .env NO se versiona. Nunca pongas credenciales reales aquí.
# ============================================================

# --- PostgreSQL local ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=urbanmove
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=urbanmove

# --- Keycloak local ---
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local
KEYCLOAK_REALM=urbanmove
KEYCLOAK_CLIENT_ID=urbanmove-api

# --- LocalStack (AWS simulado) ---
# Las credenciales test/test son las que espera LocalStack en local.
# No son credenciales reales de AWS.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET_DATALAKE=urbanmove-datalake
AWS_SQS_EVENTS_QUEUE=urbanmove-events
AWS_EVENT_BUS=urbanmove-bus

# --- Observabilidad ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO
