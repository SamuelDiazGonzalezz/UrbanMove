# ==============================================================================
# UrbanMove - Variables de Entorno Locales (.env.example)
# ==============================================================================

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=urbanmove
POSTGRES_PASSWORD=urbanmove_dev_secret_change_me
POSTGRES_PORT=5432
POSTGRES_DB=urbanmove_db

# --- LocalStack / AWS Emulado ---
LOCALSTACK_PORT=4566
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_DATALAKE_BUCKET=urbanmove-data-lake
SQS_TRIP_RECORDED_QUEUE=trip-recorded-queue

# --- Terraform (mapea variables TF_VAR_* automáticamente) ---
TF_VAR_aws_region=eu-west-1
TF_VAR_aws_endpoint_url=http://localhost:4566
TF_VAR_is_localstack=true
TF_VAR_aws_access_key=test
TF_VAR_aws_secret_key=test
TF_VAR_datalake_bucket_name=urbanmove-data-lake
TF_VAR_trip_recorded_queue_name=trip-recorded-queue

# --- Microservicio Core Fleet ---
CORE_FLEET_PORT=8080
CORE_FLEET_DB_NAME=availability_db
SPRING_PROFILES_ACTIVE=dev
