# ==============================================================================
# UrbanMove - Variables de entorno locales (.env.example)
# Copia este fichero a .env. Los valores son de desarrollo local; nunca reales.
# ==============================================================================

# --- PostgreSQL (una base por servicio + keycloak_db) ---
POSTGRES_USER=urbanmove
POSTGRES_PASSWORD=urbanmove_dev_secret_change_me
POSTGRES_PORT=5432
POSTGRES_DB=urbanmove_db

# --- Keycloak (consola de administración en http://localhost:8081) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_dev_secret_change_me
KEYCLOAK_PORT=8081

# --- LocalStack / AWS emulado ---
LOCALSTACK_PORT=4566
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Plataforma ---
GATEWAY_PORT=8080
# TTL de una reserva en segundos (máx. 900: es el retraso de la cola SQS de expiración)
RESERVATION_TTL_SECONDS=300
# Viajes desde la última revisión que disparan una orden de mantenimiento
MAINTENANCE_USAGE_LIMIT=10
