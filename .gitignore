# ============================================================
# UrbanMove - .gitignore
# ============================================================

# --- Secretos y configuración local ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/
*.secret

# --- Java / Maven ---
target/
build/
out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# --- Python (Lambdas de datos) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version

# --- Terraform / IaC ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
.terraformrc
terraform.rc

# --- LocalStack / datos locales ---
.localstack/
localstack-data/
volume/
data/
*.duckdb
*.parquet
*.avro
*.orc

# --- Logs y temporales ---
*.log
logs/
tmp/
temp/
*.tmp

# --- IDE / sistema ---
.idea/
*.iml
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.DS_Store
Thumbs.db
desktop.ini

# --- Evidencias generadas ---
reports/
test-results/
playwright-report/
screenshots/
